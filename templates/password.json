urs');\n    var minutesEl = document.getElementById('minutes');\n    var secondsEl = document.getElementById('seconds');\n    var countdownEl = document.getElementById('countdown');\n\n    function pad(n) { return n < 10 ? '0' + n : '' + n; }\n\n    function update() {\n      var now = new Date().getTime();\n      var diff = launchDate - now;\n\n      if (diff <= 0) {\n        countdownEl.innerHTML = '<p style=\"font-size:1.25rem;font-weight:600;\">C\\'est le grand jour! 🎉<\/p>';\n        clearInterval(timer);\n        return;\n      }\n\n      var days = Math.floor(diff \/ (1000 * 60 * 60 * 24));\n      var hours = Math.floor((diff % (1000 * 60 * 60 * 24)) \/ (1000 * 60 * 60));\n      var minutes = Math.floor((diff % (1000 * 60 * 60)) \/ (1000 * 60));\n      var seconds = Math.floor((diff % (1000 * 60)) \/ 1000);\n\n      daysEl.textContent = pad(days);\n      hoursEl.textContent = pad(hours);\n      minutesEl.textContent = pad(minutes);\n      secondsEl.textContent = pad(seconds);\n    }\n\n    update();\n    var timer = setInterval(update, 1000);\n  })();\n<\/script>"},"blocks":{}},"text-2":{"type":"text","name":"Text","settings":{"text":"<p>Inscrivez-vous à notre infolettre pour obtenir une offre exclusive lors de notre lancement officiel<\/p>","width":"fit-content","max_width":"normal","alignment":"left","type_preset":"rte","font":"var(--font-body--family)","font_size":"","line_height":"normal","letter_spacing":"normal","case":"none","wrap":"pretty","background":false,"background_color":"#00000026","corner_radius":0,"padding-block-start":0,"padding-block-end":32,"padding-inline-start":0,"padding-inline-end":0},"blocks":{}},"email-signup":{"type":"email-signup","name":"Email Signup","settings":{"width":"custom","custom_width":50,"heading":"","heading_preset":"h3","border_style":"all","border_width":1,"border_radius":14,"input_type_preset":"paragraph","style_class":"button","display_type":"arrow","label":"Sign up","integrated_button":false,"button_type_preset":"p