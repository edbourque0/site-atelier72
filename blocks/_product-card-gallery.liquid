

{% assign product = closest.product %}

{% capture children %}
  {% unless product == blank %}
    {%- liquid
      assign has_status_badge = false
      if product.available == false or product.compare_at_price > product.price
        assign has_status_badge = true
      endif

      # Promo badge: products carrying the promo tag, inside the optional start/end window.
      # Automatic discounts are not visible to Liquid, so the tag mirrors the discount's product list.
      assign show_promo_badge = false
      assign promo_tag = settings.promo_badge_tag | strip | downcase
      if settings.promo_badge_enabled and settings.promo_badge_text != blank and promo_tag != blank
        assign product_tags = product.tags | join: '|' | downcase | split: '|'
        if product_tags contains promo_tag
          assign show_promo_badge = true
          assign now_seconds = 'now' | date: '%s' | plus: 0
          if settings.promo_badge_starts_at != blank
            assign starts_seconds = settings.promo_badge_starts_at | date: '%s' | plus: 0
            if now_seconds < starts_seconds
              assign show_promo_badge = false
            endif
          endif
          if settings.promo_badge_ends_at != blank
            assign ends_seconds = settings.promo_badge_ends_at | date: '%s' | plus: 0
            if ends_seconds > 0 and now_seconds >= ends_seconds
              assign show_promo_badge = false
            endif
          endif
        endif
      endif

      # When status badges also sit top right, the promo badge stacks in their container.
      assign promo_shares_container = false
      if show_promo_badge and has_status_badge and settings.badge_position == 'top-right'
        assign promo_shares_container = true
      endif
    -%}
    {%- capture badges_style -%}
      --badge-border-radius: {{ settings.badge_corner_radius }}px;
      --badge-font-family: var(--font-{{ settings.badge_font_family }}--family); --badge-font-weight: var(--font-{{ settings.badge_font_family }}--weight); --badge-text-transform: {{ settings.badge_text_transform }};
    {%- endcapture -%}
    {%- capture promo_badge -%}
      <div class="product-badges__badge product-badges__badge--rectangle color-custom-badge-promo">
        {{- settings.promo_badge_text | escape -}}
      </div>
    {%- endcapture -%}
    {%- if has_status_badge -%}
      <div
        class="product-badges product-badges--{{ settings.badge_position }}"
        style="{{ badges_style }}"
      >
        <div
          class="
            product-badges__badge product-badges__badge--rectangle
            {% if product.available == false %} color-custom-badge-sold-out{% elsif product.compare_at_price > product.price %} color-custom-badge-sale{% endif %}
          "
        >
          {%- if product.available == false -%}
            {{ 'content.product_badge_sold_out' | t }}
          {%- elsif product.compare_at_price > product.price -%}
            {{ 'content.product_badge_sale' | t }}
          {%- endif -%}
        </div>
        {%- if promo_shares_container -%}
          {{ promo_badge }}
        {%- endif -%}
      </div>
    {%- endif -%}
    {%- if show_promo_badge and promo_shares_container == false -%}
      <div class="product-badges product-badges--top-right" style="{{ badges_style }}">
        {{ promo_badge }}
      </div>
    {%- endif -%}
    {% if product.available and settings.quick_add or settings.mobile_quick_add %}
      {% render 'quick-add', product: product, section_id: section.id %}
    {% endif %}
  {% endunless %}
{% endcapture %}

{% render 'card-gallery', children: children %}

{% # Title for the zoomed out grid view %}
<h3 class="product-grid-view-zoom-out--details">
  {%- if product == blank -%}
    {{- 'content.product_card_placeholder' | t -}}
  {%- else -%}
    {{- product.title -}}
  {%- endif -%}
</h3>

{% render 'product-card-gallery-zoom-details-styles' %}
{% render 'product-badges-styles' %}

{% schema %}
{
  "name": "t:names.product_image",
  "tag": null,
  "settings": [
    {
      "type": "paragraph",
      "content": "t:content.resource_reference_product_media"
    },
    {
      "type": "select",
      "id": "image_ratio",
      "options": [
        {
          "value": "adapt",
          "label": "t:options.auto"
        },
        {
          "value": "portrait",
          "label": "t:options.portrait"
        },
        {
          "value": "square",
          "label": "t:options.square"
        },
        {
          "value": "landscape",
          "label": "t:options.landscape"
        }
      ],
      "default": "portrait",
      "label": "t:settings.aspect_ratio",
      "info": "t:info.aspect_ratio_adjusted"
    },
    {
      "type": "header",
      "content": "t:content.borders"
    },
    {
      "type": "select",
      "id": "border",
      "label": "t:settings.style",
      "options": [
        {
          "value": "none",
          "label": "t:options.none"
        },
        {
          "value": "solid",
          "label": "t:options.solid"
        }
      ],
      "default": "none"
    },
    {
      "type": "range",
      "id": "border_width",
      "min": 0,
      "max": 4,
      "step": 1,
      "unit": "px",
      "label": "t:settings.thickness",
      "default": 1,
      "visible_if": "{{ block.settings.border != 'none' }}"
    },
    {
      "type": "range",
      "id": "border_opacity",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "label": "t:settings.opacity",
      "default": 100,
      "visible_if": "{{ block.settings.border != 'none' }}"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "t:settings.color",
      "placeholder": "t:settings.default",
      "visible_if": "{{ block.settings.border != 'none' }}"
    },
    {
      "type": "range",
      "id": "border_radius",
      "label": "t:settings.border_radius",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-inline-start",
      "label": "t:settings.left",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-inline-end",
      "label": "t:settings.right",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "t:names.product_card_media",
      "category": "t:categories.product"
    }
  ]
}
{% endschema %}
