{% comment %}
  Section contract.
  Brand story: a portrait image with an optional round number badge beside an eyebrow, heading,
  text and button.
  @example
  <!-- Home page "Notre histoire" after the best sellers -->
{% endcomment %}

{% render 'editorial-styles' %}

{% liquid
  assign has_background = false
  if section.settings.background_color != blank and section.settings.background_color.alpha != 0
    assign has_background = true
    render 'contrast-override', background_color: section.settings.background_color, section_id: section.id
  endif
%}

<div class="section-background{% if has_background %} color-custom-{{ section.id }}{% endif %}"></div>
<div
  class="section section--page-width spacing-style{% if has_background %} color-custom-{{ section.id }}{% endif %}"
  style="
    {% render 'spacing-style', settings: section.settings %}
    --editorial-accent: {{ section.settings.accent_color }};
    --editorial-media-background: {{ section.settings.media_background }};
    --story-badge-background: {{ section.settings.badge_background }};
    --story-badge-text: {{ section.settings.badge_text_color }};
  "
>
  <div
    class="editorial story-feature{% if section.settings.image_position == 'right' %} story-feature--reverse{% endif %}"
    {% if section.settings.anchor_id != blank %}
      id="{{ section.settings.anchor_id | handleize }}"
    {% endif %}
  >
    <div class="story-feature__visual">
      <div class="story-feature__media editorial-media">
        {%- if section.settings.image != blank -%}
          {{
            section.settings.image
            | image_url: width: 1600
            | image_tag:
              widths: '400, 600, 800, 1000, 1200, 1600',
              sizes: '(min-width: 990px) 45vw, 100vw',
              loading: 'lazy'
          }}
        {%- else -%}
          {{ 'lifestyle-1' | placeholder_svg_tag: 'story-feature__placeholder' }}
        {%- endif -%}
      </div>
      {%- if section.settings.badge_number != blank -%}
        <p class="story-feature__badge">
          <span class="story-feature__badge-number">{{ section.settings.badge_number | escape }}</span>
          {%- if section.settings.badge_label != blank -%}
            <span class="story-feature__badge-label">{{ section.settings.badge_label | escape }}</span>
          {%- endif -%}
        </p>
      {%- endif -%}
    </div>

    <div class="story-feature__content editorial-stack">
      {%- if section.settings.eyebrow != blank -%}
        <p class="editorial-eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="editorial-heading h2 story-feature__heading">{{ section.settings.heading }}</h2>
      {%- endif -%}
      {%- if section.settings.text != blank -%}
        <div class="editorial-text rte">{{ section.settings.text }}</div>
      {%- endif -%}
      {% render 'editorial-button',
        label: section.settings.button_label,
        link: section.settings.button_link,
        style: section.settings.button_style
      %}
    </div>
  </div>
</div>

{% stylesheet %}
  .story-feature {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: clamp(2rem, 6vw, 6rem);
  }

  .story-feature--reverse {
    flex-direction: row-reverse;
  }

  .story-feature__visual {
    position: relative;
    flex: 1 1 28rem;
    min-width: 0;
  }

  .story-feature__media {
    aspect-ratio: 4 / 5;
  }

  .story-feature__placeholder {
    fill: rgb(var(--color-foreground-rgb) / var(--opacity-30));
  }

  .story-feature__badge {
    position: absolute;
    inset-inline-end: -1.5rem;
    inset-block-end: 2.5rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.25rem;
    inline-size: clamp(8.5rem, 14vw, 12.5rem);
    aspect-ratio: 1;
    margin: 0;
    padding: 1rem;
    border-radius: 50%;
    background-color: var(--story-badge-background);
    color: var(--story-badge-text);
    box-shadow: 0 0 0 0.625rem var(--color-background);
    text-align: center;
  }

  .story-feature__badge-number {
    font-family: var(--font-accent--family);
    font-weight: var(--font-accent--weight);
    font-size: clamp(2.5rem, 4vw, 3.5rem);
    line-height: 1;
  }

  .story-feature__badge-label {
    font-size: 0.625rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--editorial-accent-on-dark, #C9B48A);
  }

  .story-feature__content {
    flex: 1 1 30rem;
    gap: 1.75rem;
  }

  .story-feature__content .editorial-button {
    align-self: flex-start;
  }

  @media (max-width: 749px) {
    .story-feature__badge {
      inset-inline-end: 1rem;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.story_feature",
  "class": "section-wrapper",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:settings.image"
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "t:settings.image_position",
      "options": [
        {
          "value": "left",
          "label": "t:options.left"
        },
        {
          "value": "right",
          "label": "t:options.right"
        }
      ],
      "default": "left"
    },
    {
      "type": "text",
      "id": "badge_number",
      "label": "t:settings.badge_number",
      "default": "72"
    },
    {
      "type": "text",
      "id": "badge_label",
      "label": "t:settings.badge_label",
      "default": "t:text_defaults.story_feature_badge"
    },
    {
      "type": "header",
      "content": "t:content.text"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:settings.eyebrow",
      "default": "t:text_defaults.story_feature_eyebrow"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "t:settings.heading",
      "default": "t:text_defaults.story_feature_heading"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "t:settings.text",
      "default": "t:html_defaults.story_feature_text"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "t:settings.label",
      "default": "t:text_defaults.story_feature_button"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "t:settings.link"
    },
    {
      "type": "select",
      "id": "button_style",
      "label": "t:settings.button_style",
      "options": [
        {
          "value": "primary",
          "label": "t:options.primary"
        },
        {
          "value": "light",
          "label": "t:options.light"
        },
        {
          "value": "outline",
          "label": "t:options.outline"
        }
      ],
      "default": "primary"
    },
    {
      "type": "text",
      "id": "anchor_id",
      "label": "t:settings.anchor_id",
      "info": "t:info.anchor_id"
    },
    {
      "type": "header",
      "content": "t:content.colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "t:settings.background_color",
      "alpha": true,
      "default": "{{ settings.color_palette.color4 }}"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "t:settings.accent_color",
      "default": "#8A6A3C"
    },
    {
      "type": "color",
      "id": "media_background",
      "label": "t:settings.media_background",
      "default": "#C9B48A"
    },
    {
      "type": "color",
      "id": "badge_background",
      "label": "t:settings.badge_background",
      "default": "{{ settings.color_palette.color1 }}"
    },
    {
      "type": "color",
      "id": "badge_text_color",
      "label": "t:settings.badge_text_color",
      "default": "{{ settings.color_palette.color4 }}"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 120
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 120
    }
  ],
  "presets": [
    {
      "name": "t:names.story_feature",
      "category": "t:categories.storytelling"
    }
  ]
}
{% endschema %}
