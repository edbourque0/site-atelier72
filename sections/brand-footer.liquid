{% comment %}
  Section contract.
  Brand footer: logo and tagline, up to two menus, social links, then a bottom bar with copyright,
  policy links and the current country / currency.
  @example
  <!-- Footer group. Pick menus in the section settings; social URLs are plain links -->
{% endcomment %}

{%- liquid
  # Menu links to collections with no products published to the online store are skipped when the
  # theme setting is on. -1 never matches a product count, so nothing is skipped when it is off.
  assign empty_collection_count = -1
  if settings.menu_hide_empty_collections
    assign empty_collection_count = 0
  endif
-%}

{% liquid
  assign has_background = false
  if section.settings.background_color != blank and section.settings.background_color.alpha != 0
    assign has_background = true
    render 'contrast-override', background_color: section.settings.background_color, section_id: section.id
  endif
  assign socials = 'instagram,tiktok,facebook' | split: ','
  assign has_social = false
  for social in socials
    assign key = social | append: '_url'
    if section.settings[key] != blank
      assign has_social = true
    endif
  endfor
%}

<div class="section-background{% if has_background %} color-custom-{{ section.id }}{% endif %}"></div>
<footer
  class="section section--page-width brand-footer{% if has_background %} color-custom-{{ section.id }}{% endif %}"
  style="--brand-footer-accent: {{ section.settings.accent_color }};"
>
  <div class="brand-footer__inner">
    <div class="brand-footer__top">
      <div class="brand-footer__brand">
        <a href="{{ routes.root_url }}" class="brand-footer__logo-link">
          {%- if settings.brand_logo_files -%}
            {% render 'brand-logo', variant: 'cream', lockup: 'stacked', class: 'brand-footer__logo', loading: 'lazy' %}
          {%- elsif settings.logo_inverse != blank -%}
            {{ settings.logo_inverse | image_url: width: 600 | image_tag: class: 'brand-footer__logo', loading: 'lazy', alt: shop.name }}
          {%- else -%}
            <span class="brand-footer__wordmark">{{ shop.name | escape }}</span>
          {%- endif -%}
        </a>
        {%- if section.settings.tagline != blank -%}
          <p class="brand-footer__tagline">{{ section.settings.tagline | escape }}</p>
        {%- endif -%}
      </div>

      <div class="brand-footer__columns">
        {%- for i in (1..2) -%}
          {%- liquid
            assign menu_key = 'menu_' | append: i
            assign heading_key = 'menu_' | append: i | append: '_heading'
            assign menu = section.settings[menu_key]
          -%}
          {%- if menu != blank and menu.links.size > 0 -%}
            <nav class="brand-footer__column" aria-label="{{ section.settings[heading_key] | default: menu.title | escape }}">
              <p class="brand-footer__heading">{{ section.settings[heading_key] | default: menu.title | escape }}</p>
              <ul class="brand-footer__links" role="list">
                {%- for link in menu.links -%}
                  {%- if link.object.products_count == empty_collection_count -%}{%- continue -%}{%- endif -%}
                  <li><a href="{{ link.url }}">{{ link.title | escape }}</a></li>
                {%- endfor -%}
              </ul>
            </nav>
          {%- endif -%}
        {%- endfor -%}

        {%- if has_social -%}
          <div class="brand-footer__column">
            <p class="brand-footer__heading">{{ section.settings.social_heading | escape }}</p>
            <ul class="brand-footer__links" role="list">
              {%- if section.settings.instagram_url != blank -%}
                <li><a href="{{ section.settings.instagram_url }}" target="_blank" rel="noopener">Instagram</a></li>
              {%- endif -%}
              {%- if section.settings.tiktok_url != blank -%}
                <li><a href="{{ section.settings.tiktok_url }}" target="_blank" rel="noopener">TikTok</a></li>
              {%- endif -%}
              {%- if section.settings.facebook_url != blank -%}
                <li><a href="{{ section.settings.facebook_url }}" target="_blank" rel="noopener">Facebook</a></li>
              {%- endif -%}
            </ul>
          </div>
        {%- endif -%}
      </div>
    </div>

    <div class="brand-footer__bottom">
      <p>&copy; {{ 'now' | date: '%Y' }} {{ shop.name | escape }}</p>
      {%- if shop.policies.size > 0 -%}
        <ul class="brand-footer__policies" role="list">
          {%- for policy in shop.policies -%}
            <li><a href="{{ policy.url }}">{{ policy.title | escape }}</a></li>
          {%- endfor -%}
        </ul>
      {%- endif -%}
      <p>{{ localization.country.name }} ({{ localization.country.currency.iso_code }} {{ localization.country.currency.symbol }})</p>
    </div>
  </div>
</footer>

{% stylesheet %}
  .brand-footer {
    padding-block: clamp(3.5rem, 7vw, 5.625rem) 0;
  }

  .brand-footer__top {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 3.5rem;
  }

  .brand-footer__brand {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    max-inline-size: 20rem;
  }

  .brand-footer__logo-link {
    align-self: flex-start;
  }

  .brand-footer__logo {
    display: block;
    block-size: 5.5rem;
    inline-size: auto;
  }

  .brand-footer__wordmark {
    font-family: var(--font-heading--family);
    font-size: 2rem;
    font-weight: var(--font-heading--weight);
    letter-spacing: var(--brand-tracking-display, -0.02em);
    color: var(--color-foreground);
  }

  .brand-footer__tagline {
    margin: 0;
    font-size: 0.875rem;
    line-height: 1.7;
    color: rgb(var(--color-foreground-rgb) / var(--opacity-80));
  }

  .brand-footer__columns {
    display: flex;
    flex-wrap: wrap;
    gap: clamp(2rem, 6vw, 6rem);
  }

  .brand-footer__heading {
    margin: 0 0 0.75rem;
    font-family: var(--font-accent--family);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: var(--brand-tracking-eyebrow, 0.14em);
    text-transform: uppercase;
    color: var(--brand-footer-accent);
  }

  .brand-footer__links {
    display: flex;
    flex-direction: column;
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: 0.875rem;
  }

  .brand-footer__links a,
  .brand-footer__policies a {
    display: inline-block;
    padding-block: 0.375rem;
    color: var(--color-foreground);
    text-decoration: none;
    background-image: linear-gradient(currentColor, currentColor);
    background-size: 0 1px;
    background-repeat: no-repeat;
    background-position: 0 85%;
    transition: background-size var(--animation-speed-slow, 0.4s) var(--animation-easing);
  }

  .brand-footer__links a:hover,
  .brand-footer__policies a:hover {
    background-size: 100% 1px;
  }

  .brand-footer__bottom {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 0.75rem 1.5rem;
    margin-block-start: clamp(3rem, 6vw, 4.375rem);
    padding-block: 1.375rem;
    border-block-start: 1px solid rgb(var(--color-foreground-rgb) / var(--opacity-15));
    font-size: 0.75rem;
    color: rgb(var(--color-foreground-rgb) / var(--opacity-70));
  }

  .brand-footer__bottom p {
    margin: 0;
  }

  .brand-footer__policies {
    display: flex;
    flex-wrap: wrap;
    gap: 0 1rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .brand-footer__policies a {
    color: inherit;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.brand_footer",
  "enabled_on": {
    "groups": ["footer"]
  },
  "settings": [
    {
      "type": "text",
      "id": "tagline",
      "label": "t:settings.tagline",
      "default": "t:text_defaults.brand_footer_tagline"
    },
    {
      "type": "link_list",
      "id": "menu_1",
      "label": "t:settings.first_menu"
    },
    {
      "type": "text",
      "id": "menu_1_heading",
      "label": "t:settings.first_menu_heading"
    },
    {
      "type": "link_list",
      "id": "menu_2",
      "label": "t:settings.second_menu"
    },
    {
      "type": "text",
      "id": "menu_2_heading",
      "label": "t:settings.second_menu_heading"
    },
    {
      "type": "header",
      "content": "t:content.social_media"
    },
    {
      "type": "text",
      "id": "social_heading",
      "label": "t:settings.heading",
      "default": "t:text_defaults.brand_footer_social"
    },
    {
      "type": "url",
      "id": "instagram_url",
      "label": "t:settings.instagram_url"
    },
    {
      "type": "url",
      "id": "tiktok_url",
      "label": "t:settings.tiktok_url"
    },
    {
      "type": "url",
      "id": "facebook_url",
      "label": "t:settings.facebook_url"
    },
    {
      "type": "header",
      "content": "t:content.colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "t:settings.background_color",
      "alpha": true,
      "default": "{{ settings.color_palette.color2 }}"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "t:settings.accent_color",
      "default": "{{ settings.color_palette.color4 }}"
    }
  ],
  "presets": [
    {
      "name": "t:names.brand_footer",
      "category": "t:categories.footer"
    }
  ]
}
{% endschema %}
