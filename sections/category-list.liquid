{% comment %}
  Section contract.
  Category index with two layouts. Rows: full-width numbered rows, each linking to a collection with
  a short description and a thumbnail; rows take the primary button colors on hover. Tiles: large
  4:5 photos with the name underneath, up to four per row, scrolling sideways on phones.
  @example
  <!-- Home page "Magasiner par catégorie": add one Category block per collection -->
{% endcomment %}

{% render 'editorial-styles' %}

{% liquid
  assign has_background = false
  if section.settings.background_color != blank and section.settings.background_color.alpha != 0
    assign has_background = true
    render 'contrast-override', background_color: section.settings.background_color, section_id: section.id
  endif
%}

<div class="section-background{% if has_background %} color-custom-{{ section.id }}{% endif %}"></div>
<div
  class="section section--full-width spacing-style{% if has_background %} color-custom-{{ section.id }}{% endif %}"
  style="
    {% render 'spacing-style', settings: section.settings %}
    --editorial-accent: {{ section.settings.accent_color }};
    --editorial-media-background: {{ section.settings.media_background }};
  "
>
  <div class="editorial category-list">
    {%- if section.settings.heading != blank or section.settings.text != blank -%}
      <div class="editorial-header category-list__header">
        {%- if section.settings.heading != blank -%}
          <h2 class="editorial-heading h3">{{ section.settings.heading }}</h2>
        {%- endif -%}
        {%- if section.settings.text != blank -%}
          <p class="category-list__intro">{{ section.settings.text | escape }}</p>
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- liquid
      assign layout = section.settings.layout | default: 'rows'
      assign tile_columns = section.blocks.size | at_most: 4 | at_least: 1
    -%}
    <ol
      class="category-list__{{ layout }}"
      role="list"
      {% if layout == 'tiles' %}
        style="--category-columns: {{ tile_columns }};"
      {% endif %}
    >
      {%- for block in section.blocks -%}
        {%- liquid
          assign collection = block.settings.collection
          assign title = block.settings.title | default: collection.title
          if title == blank
            assign title = 'placeholders.collection_title' | t
          endif
          assign image = block.settings.image | default: collection.featured_image
          if image == blank and collection != blank
            assign image = collection.products.first.featured_media
          endif
          assign number = forloop.index | prepend: '0' | slice: -2, 2
        -%}
        {%- if collection == blank and request.design_mode == false -%}
          {%- continue -%}
        {%- endif -%}
        {%- if layout == 'tiles' -%}
          <li class="category-list__tile" {{ block.shopify_attributes }}>
            <a
              class="category-list__tile-link"
              href="{{ collection.url | default: routes.collections_url }}"
            >
              <span class="category-list__tile-media editorial-media">
                {%- if image != blank -%}
                  {{
                    image
                    | image_url: width: 1200
                    | image_tag:
                      widths: '360, 540, 720, 900, 1200',
                      sizes: '(min-width: 750px) 33vw, 75vw',
                      loading: 'lazy',
                      alt: ''
                  }}
                {%- else -%}
                  {{ 'collection-1' | placeholder_svg_tag: 'category-list__placeholder' }}
                {%- endif -%}
              </span>
              <span class="category-list__tile-label">
                <span class="category-list__tile-name">{{ title | escape }}</span>
                <span class="category-list__tile-arrow" aria-hidden="true">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
                </span>
              </span>
              {%- if block.settings.description != blank -%}
                <span class="category-list__tile-text">{{ block.settings.description | escape }}</span>
              {%- endif -%}
            </a>
          </li>
        {%- else -%}
          <li class="category-list__item" {{ block.shopify_attributes }}>
            <a
              class="category-list__row"
              href="{{ collection.url | default: routes.collections_url }}"
            >
              <span class="category-list__number" aria-hidden="true">{{ number }}</span>
              <span class="category-list__name">
                {{- title | escape -}}
              </span>
              {%- if block.settings.description != blank -%}
                <span class="category-list__description">{{ block.settings.description | escape }}</span>
              {%- endif -%}
              <span class="category-list__thumb editorial-media" aria-hidden="true">
                {%- if image != blank -%}
                  {{
                    image
                    | image_url: width: 480
                    | image_tag: widths: '160, 240, 320, 480', sizes: '120px', loading: 'lazy', alt: ''
                  }}
                {%- endif -%}
              </span>
              <span class="category-list__arrow" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M7 17 17 7M9 7h8v8"/></svg>
              </span>
            </a>
          </li>
        {%- endif -%}
      {%- endfor -%}
    </ol>
  </div>
</div>

{% stylesheet %}
  .category-list__header {
    padding-inline: var(--util-page-margin-offset);
  }

  .category-list__intro {
    margin: 0;
    max-width: 20rem;
    color: rgb(var(--color-foreground-rgb) / var(--opacity-70));
  }

  .category-list__rows {
    margin: 0;
    padding: 0;
    list-style: none;
    border-block-start: 1px solid rgb(var(--color-foreground-rgb) / var(--opacity-15));
  }

  .category-list__item {
    border-block-end: 1px solid rgb(var(--color-foreground-rgb) / var(--opacity-15));
  }

  .category-list__row {
    display: flex;
    align-items: center;
    gap: clamp(1rem, 3vw, 3rem);
    padding-block: 1.375rem;
    padding-inline: var(--util-page-margin-offset);
    color: var(--color-foreground);
    text-decoration: none;
    transition: background-color var(--animation-speed) var(--animation-easing),
      color var(--animation-speed) var(--animation-easing);
  }

  .category-list__row:hover,
  .category-list__row:focus-visible {
    background-color: var(--color-primary-button-background);
    color: var(--color-primary-button-text);
  }

  .category-list__row:focus-visible {
    outline-offset: -0.25rem;
  }

  .category-list__number {
    flex: 0 0 2rem;
    font-family: var(--font-accent--family);
    font-weight: var(--font-accent--weight);
    font-size: 1.125rem;
    color: var(--editorial-accent);
  }

  .category-list__name {
    flex: 1;
    min-width: 0;
    font-family: var(--font-heading--family);
    font-weight: var(--font-heading--weight);
    font-size: clamp(2rem, 4vw, 3.25rem);
    line-height: 1.08;
    letter-spacing: -0.025em;
    overflow-wrap: break-word;
    hyphens: auto;
  }

  .category-list__description {
    flex: 0 1 16.25rem;
    font-size: 0.875rem;
    color: rgb(var(--color-foreground-rgb) / var(--opacity-70));
  }

  .category-list__row:is(:hover, :focus-visible) :is(.category-list__number, .category-list__description) {
    color: inherit;
  }

  .category-list__thumb {
    flex: 0 0 7.5rem;
    block-size: 5.25rem;
    border-radius: var(--editorial-radius);
  }

  .category-list__arrow {
    display: grid;
    place-items: center;
    flex: 0 0 3.25rem;
    block-size: 3.25rem;
    border: 1px solid currentColor;
    border-radius: 50%;
    transition: background-color var(--animation-speed) var(--animation-easing),
      color var(--animation-speed) var(--animation-easing);
  }

  .category-list__arrow svg {
    inline-size: 1.125rem;
    block-size: 1.125rem;
  }

  .category-list__arrow svg:dir(rtl) {
    transform: scaleX(-1);
  }

  .category-list__row:is(:hover, :focus-visible) .category-list__arrow {
    background-color: var(--color-primary-button-text);
    color: var(--color-primary-button-background);
  }

  /* Tiles */
  .category-list__tiles {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: minmax(16rem, 72%);
    gap: var(--brand-space-4, 1rem);
    margin: 0;
    padding-block: 0 var(--brand-space-2, 0.5rem);
    padding-inline: var(--util-page-margin-offset);
    scroll-padding-inline: var(--util-page-margin-offset);
    list-style: none;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
  }

  .category-list__tiles::-webkit-scrollbar {
    display: none;
  }

  .category-list__tile {
    min-width: 0;
    scroll-snap-align: start;
  }

  .category-list__tile-link {
    display: flex;
    flex-direction: column;
    gap: var(--brand-space-3, 0.75rem);
    color: var(--color-foreground);
    text-decoration: none;
  }

  .category-list__tile-link:focus-visible {
    outline-offset: 4px;
  }

  .category-list__tile-media {
    aspect-ratio: 4 / 5;
  }

  .category-list__tile-label {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--brand-space-3, 0.75rem);
  }

  .category-list__tile-name {
    min-width: 0;
    font-family: var(--font-accent--family);
    font-weight: var(--font-accent--weight);
    font-size: 1.25rem;
    line-height: 1.3;
    letter-spacing: -0.01em;
  }

  .category-list__tile-arrow {
    display: grid;
    place-items: center;
    flex: 0 0 auto;
    inline-size: 2.5rem;
    block-size: 2.5rem;
    border: 1px solid rgb(var(--color-foreground-rgb) / var(--opacity-30));
    border-radius: var(--brand-radius-pill, 999px);
    transition: background-color var(--brand-duration, 0.18s) var(--brand-ease, ease-out),
      color var(--brand-duration, 0.18s) var(--brand-ease, ease-out),
      border-color var(--brand-duration, 0.18s) var(--brand-ease, ease-out);
  }

  .category-list__tile-arrow svg {
    inline-size: 1.125rem;
    block-size: 1.125rem;
  }

  .category-list__tile-arrow svg:dir(rtl) {
    transform: scaleX(-1);
  }

  .category-list__tile-link:is(:hover, :focus-visible) .category-list__tile-arrow {
    border-color: var(--color-primary-button-background);
    background-color: var(--color-primary-button-background);
    color: var(--color-primary-button-text);
  }

  .category-list__tile-text {
    font-size: 0.875rem;
    color: rgb(var(--color-foreground-rgb) / var(--opacity-70));
  }

  .category-list__placeholder {
    fill: rgb(var(--color-foreground-rgb) / var(--opacity-30));
  }

  @media (min-width: 750px) {
    .category-list__tiles {
      grid-auto-flow: row;
      grid-template-columns: repeat(var(--category-columns, 3), minmax(0, 1fr));
      gap: var(--brand-space-5, 1.5rem);
      overflow: visible;
    }
  }

  @media (max-width: 749px) {
    .category-list__row .category-list__description,
    .category-list__row .category-list__thumb {
      display: none;
    }

    .category-list__arrow {
      flex-basis: 2.75rem;
      block-size: 2.75rem;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.category_list",
  "class": "section-wrapper",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "max_blocks": 12,
  "blocks": [
    {
      "type": "category",
      "name": "t:names.category",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "t:settings.collection"
        },
        {
          "type": "text",
          "id": "title",
          "label": "t:settings.title",
          "info": "t:info.category_title"
        },
        {
          "type": "text",
          "id": "description",
          "label": "t:settings.description"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "t:settings.image",
          "info": "t:info.category_image"
        }
      ]
    }
  ],
  "settings": [
    {
      "type": "select",
      "id": "layout",
      "label": "t:settings.layout",
      "options": [
        {
          "value": "rows",
          "label": "t:options.category_rows"
        },
        {
          "value": "tiles",
          "label": "t:options.category_tiles"
        }
      ],
      "default": "rows"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "t:settings.heading",
      "default": "t:text_defaults.category_list_heading"
    },
    {
      "type": "text",
      "id": "text",
      "label": "t:settings.text",
      "default": "t:text_defaults.category_list_text"
    },
    {
      "type": "header",
      "content": "t:content.colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "t:settings.background_color",
      "alpha": true
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "t:settings.accent_color",
      "default": "#8B5F3C"
    },
    {
      "type": "color",
      "id": "media_background",
      "label": "t:settings.media_background",
      "default": "{{ settings.color_palette.color4 }}"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 120
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "t:names.category_list",
      "category": "t:categories.collections",
      "blocks": {
        "category_1": {
          "type": "category"
        },
        "category_2": {
          "type": "category"
        },
        "category_3": {
          "type": "category"
        }
      },
      "block_order": ["category_1", "category_2", "category_3"]
    }
  ]
}
{% endschema %}
