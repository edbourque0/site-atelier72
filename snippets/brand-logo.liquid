{% doc %}
  Renders a bundled Atelier72 logo lockup (single-ink SVG from the brand design system).
  Pick the ink for the ground: 'green' (fairway) on crème or white, 'cream' on fairway, tobacco,
  black or photography. 'ink' is kept as an alias of 'green' for existing callers.

  @param {string} [variant] - 'green' (default), 'cream', or 'ink' (alias of 'green').
  @param {string} [lockup] - 'horizontal' (default, headers and tight heights) or 'stacked' (primary mark).
  @param {string} [alt] - Alternative text. Defaults to the shop name.
  @param {string} [class] - Classes added to the image.
  @param {string} [loading] - 'eager' (default) or 'lazy'.

  @example
  {% render 'brand-logo', variant: 'cream', lockup: 'stacked', class: 'brand-footer__logo', loading: 'lazy' %}
{% enddoc %}

{%- liquid
  assign variant = variant | default: 'green'
  if variant == 'ink'
    assign variant = 'green'
  endif
  assign lockup = lockup | default: 'horizontal'
  assign alt = alt | default: shop.name
  assign loading = loading | default: 'eager'

  # Intrinsic sizes match each lockup's SVG viewBox.
  if lockup == 'stacked'
    assign width = 736
    assign height = 436
  else
    assign lockup = 'horizontal'
    assign width = 964
    assign height = 261
  endif

  assign file = 'logo-atelier72-' | append: lockup | append: '-' | append: variant | append: '.svg'
-%}
<img
  src="{{ file | asset_url }}"
  width="{{ width }}"
  height="{{ height }}"
  alt="{{ alt | escape }}"
  loading="{{ loading }}"
  {% if class %}
    class="{{ class }}"
  {% endif %}
>
